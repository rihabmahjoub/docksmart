# Copy to .env and adjust for your deployment. All have sane defaults in
# app/config.py — you only need to set what differs from the default.

# DOCKSMART_DATA_DIR=/app/data
# VINA_BINARY=vina
# FPOCKET_BINARY=fpocket
# DOCKSMART_EXHAUSTIVENESS=8
# DOCKSMART_NUM_MODES=9
# DOCKSMART_MAX_UPLOAD_MB=15
# DOCKSMART_JOB_TIMEOUT=900
# DOCKSMART_MAX_CONCURRENT_JOBS=1
# DOCKSMART_MEEKO_TIMEOUT=600      # raise this if receptor_pdbqt/ligand_pdbqt stages
#                                    # time out — very likely on slow free-tier CPU
#                                    # allocations, not a stuck process
# DOCKSMART_FPOCKET_TIMEOUT=600     # same idea for the pocket_detection stage
